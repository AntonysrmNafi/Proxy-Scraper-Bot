# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Required. Get one from @BotFather on Telegram (/newbot).
BOT_TOKEN=your_bot_token_here

# Optional. Where the SQLite database is stored. The default is fine for most setups -
# only change this if you need the database somewhere else (e.g. a mounted volume path).
DB_PATH=data/proxybot.db
